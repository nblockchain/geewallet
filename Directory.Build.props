<Project>
  <PropertyGroup>
    <!-- SDK-built libraries are also consumed by Mono's legacy F# compiler via
         xbuild, which cannot read compressed F# signature/optimization metadata. -->
    <CompressMetadata>false</CompressMetadata>
    <OtherFlags>$(OtherFlags) --warnon:0193</OtherFlags>
    <OtherFlags>$(OtherFlags) --warnon:1182</OtherFlags>
    <OtherFlags>$(OtherFlags) --warnon:3218</OtherFlags>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- TODO: remove this from master branch -->
  <PropertyGroup>
    <!-- "The target framework 'net6.0' is out of support and will not receive security updates in the future." -->
    <WarningsNotAsErrors>NETSDK1138</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
